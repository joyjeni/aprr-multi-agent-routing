flowchart TD
    Q(["<b>Query Q</b>"]):::input
    ENC["<b>1 · Query Encoder</b><br/>Sentence-BERT / MiniLM<br/>e_Q ∈ R^D"]:::cut
    LAT["<b>2 · Variational Latent</b><br/>H ~ N(μ, σ²)"]:::cut
    MODE["<b>3 · Collaboration-Mode<br/>Determiner F_θt</b><br/>topology T ∈ {Chain, Tree,<br/>Graph, Debate, MacNet}<br/>k=⌈δ(H)·γ⌉, γ=6 max"]:::cut
    ROLE["<b>4 · Agent Role<br/>Allocator F_θr</b><br/>autoregressive cascade<br/>over a 26-role pool"]:::cut
    LLMR["<b>5 · Agent LLM<br/>Router F_θm</b><br/>multinomial backbone pick:<br/>GPT-4o-mini, Claude-3.5-Haiku,<br/>Gemini-1.5-Flash, Llama-3.1-70B"]:::cut
    EXEC["<b>6 · Execute MAS</b><br/>agents run in topology T<br/>with assigned roles &amp; backbones"]:::exec
    REW["<b>7 · Reward</b><br/>R = U(S;Q,a) − λ·C(S;Q)"]:::reward
    TRAIN["<b>8 · Policy-Gradient<br/>Update</b><br/>θ ← θ − α·∇θ E[−R]<br/>REINFORCE, K=5–10 iters/query"]:::train
    NOTE["<i>θt, θr, θm updated offline;<br/>applied to stages 3–5 next query</i>"]:::note

    Q --> ENC --> LAT --> MODE --> ROLE --> LLMR --> EXEC --> REW --> TRAIN
    TRAIN -.->|"offline update loop"| NOTE

