flowchart TD
    Q(["<b>Query Q</b>"]):::input
    KW["<b>1 · Domain-Keyword<br/>Inference</b><br/>heuristic keyword match<br/><i>zero trainable parameters</i>"]:::light
    ROW["<b>2 · Affinity Matrix<br/>Row Lookup</b><br/>W[i, :] ∈ R^N<br/>N×N routing-affinity matrix"]:::core
    POL["<b>3 · Policy Computation</b><br/>P(aj|ai,q) ∝<br/>W_ij^α · η_ij^β · ψj(q)^γ"]:::core
    SEL["<b>4 · Agent Selection</b><br/>argmax / sample aj"]:::core
    EXEC["<b>5 · Tool / API<br/>Execution</b><br/>ToolBench real APIs"]:::exec
    OUT["<b>6 · Observe Outcome</b><br/>success ∈ {0,1}<br/>path length L, latency"]:::observe
    UPD["<b>7 · Online Update</b><br/>ΔW ∝ 1[success] / (L²·lat_norm)<br/>W ← (1−λ)·W + ΔW<br/><i>no gradients, no offline training</i>"]:::update
    NOTE["<i>ΔW reinforces the affinity-<br/>matrix row used in stage 2</i>"]:::note

    Q --> KW --> ROW --> POL --> SEL --> EXEC --> OUT --> UPD
    UPD -.->|"per-query online loop"| NOTE

